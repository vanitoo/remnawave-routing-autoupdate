# Remnawave API inside the default Docker network
REMNA_BASE_URL=http://remnawave:3000/api
REMNA_TOKEN=put_your_api_token_here

# PinRouting profile for Happ
GITHUB_RAW_URL=https://raw.githubusercontent.com/pincetgore/PinRouting/refs/heads/main/HAPP/DEFAULT.DEEPLINK

# Exact Remnawave Response Rule name
RESPONSE_RULE_NAME=Happ Clients

# Check once per hour. The first check runs immediately after container start.
CHECK_INTERVAL=3600
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
